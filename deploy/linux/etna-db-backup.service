# One backup of the ETNA database (deploy/linux/etna-db-backup.sh), started
# daily by etna-db-backup.timer. Change the database or folder with
# `systemctl edit etna-db-backup` (docs/INSTALL-LINUX.md).

[Unit]
Description=ETNA database backup
After=postgresql.service

[Service]
Type=oneshot
User=postgres
Group=postgres
ExecStart=/opt/etna/bin/etna-db-backup.sh etna /var/backups/etna
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/backups/etna
