# The Terminal worker: background jobs (dataset tables, imports, pipelines,
# schedules). Installed by deploy/linux/install.sh; docs/INSTALL-LINUX.md.

[Unit]
Description=ETNA Terminal worker
Documentation=file:///opt/etna/current/docs/INSTALL-LINUX.md
After=network-online.target postgresql.service etna.service
Wants=network-online.target

[Service]
Type=simple
User=etna
Group=etna
WorkingDirectory=/opt/etna/current
ExecStart=/usr/bin/env node /opt/etna/current/scripts/server/env-run.mjs /etc/etna/etna.env worker
Restart=on-failure
RestartSec=10
# The worker finishes or hands back its jobs within 30 seconds.
TimeoutStopSec=40
# Exit 3: this Node.js cannot run the worker (22.18 or newer is needed).
RestartPreventExitStatus=3
# Logs go to the journal: journalctl -u etna-worker

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/etna
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
SystemCallArchitectures=native
UMask=0027

[Install]
WantedBy=multi-user.target
