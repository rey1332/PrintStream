# Settings for deploy/docker/compose.yml. Copy to .env (never commit it).
# The app's own keys are generated on first start and kept in the config
# volume (/config/etna.env); back that volume up with the database.

# PostgreSQL superuser (only the database container uses it).
POSTGRES_PASSWORD=
# The schema owner etna_owner: migrations and account administration.
ETNA_OWNER_PASSWORD=

# The app listens on 127.0.0.1:<ETNA_PORT> of this machine.
ETNA_PORT=4028

# Behind a reverse proxy (the caddy service, or nginx/Caddy on this machine):
# TRUST_PROXY=1
# The address people open ETNA at (password reset and invite links).
# ETNA_PUBLIC_URL=https://erp.example.com
# For the caddy service (docker compose --profile https up -d):
# ETNA_DOMAIN=erp.example.com
