{
  "name": "etna",
  "version": "1.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 4028",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 4028",
    "worker": "node scripts/server/worker.mjs",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,md,json}\"",
    "check": "tsc --noEmit && npm test && node tests/i18n/scan.mjs && npm run format:check",
    "verify": "npm run check && next lint && next build && npm audit --omit=dev --audit-level=high",
    "serve": "next start -H 127.0.0.1",
    "type-check": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:db",
    "test:unit": "node --import ./tests/register-ts.mjs --test \"tests/unit/*.test.mjs\"",
    "test:db": "node --import ./tests/register-ts.mjs --test \"tests/db/*.test.mjs\"",
    "i18n:tables": "node --import ./tests/register-ts.mjs scripts/i18n/tables.mjs",
    "db:migrate": "node scripts/db/migrate.mjs",
    "db:new": "node scripts/db/new-migration.mjs",
    "db:backup": "node scripts/db/backup.mjs",
    "pc:backup": "node scripts/db/pc-move.mjs backup",
    "pc:restore": "node scripts/db/pc-move.mjs restore",
    "pc:verify": "node scripts/db/pc-move.mjs verify",
    "package": "node scripts/server/package.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@electric-sql/pglite": "^0.3.16",
    "@heroicons/react": "^2.2.0",
    "@lezer/highlight": "^1.2.5",
    "@xyflow/react": "^12.11.6",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^1.34.0",
    "next": "^15.5.28",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "quickjs-emscripten": "0.32.0",
    "react": "19.0.3",
    "react-dom": "19.0.3",
    "recharts": "^2.15.2",
    "sonner": "^1.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.3",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "autoprefixer": "10.4.2",
    "eslint": "^9",
    "eslint-config-next": "^15.5.28",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "postcss": "^8.5.28",
    "prettier": "^3.5.3",
    "tailwindcss": "3.4.6",
    "typescript": "^5"
  },
  "description": "PrintStream by ETNA: enterprise data integration and intelligence platform",
  "keywords": [
    "erp",
    "nextjs",
    "etna"
  ],
  "author": "Rayhan Akmal",
  "license": "Proprietary Notice",
  "type": "commonjs",
  "imports": {
    "#i18n-source": {
      "browser": "./src/lib/i18n/source.client.ts",
      "default": "./src/lib/i18n/source.server.ts"
    }
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  }
}
