# Auto detect text files and perform LF normalization
* text=auto

# Windows batch files must keep CRLF line endings (cmd.exe misreads labels/goto with LF only)
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Linux deployment files must keep LF line endings (sh, systemd and Docker misread CRLF)
*.sh text eol=lf
*.service text eol=lf
*.timer text eol=lf
Dockerfile text eol=lf
deploy/** text eol=lf
