# ETNA settings. Copy what you need into .env.local (never commit real values).
# scripts/setup-local.mjs writes the four required settings for you.
# Full reference: docs/teknis/CONFIGURATION.md

# ─── Required (written by scripts/setup-local.mjs) ───────────────────────────

# App connections (server only). Same machine:
DATABASE_URL=postgres://etna_app:PASSWORD@localhost:5432/etna
AUTH_DATABASE_URL=postgres://etna_auth:PASSWORD@localhost:5432/etna
# The TERMINAL worker (npm run worker): background jobs, as the role etna_worker.
WORKER_DATABASE_URL=postgres://etna_worker:PASSWORD@localhost:5432/etna
# Database on another server: encrypt and check its certificate, e.g.
# DATABASE_URL=postgres://etna_app:PASSWORD@10.0.0.20:5432/etna?sslmode=verify-full&sslrootcert=C:/ETNA-certs/db-ca.crt

# 32 random bytes, base64 — encrypts two-factor secrets. Losing it means every
# user must enroll their authenticator again.
MFA_ENCRYPTION_KEY=

# At least 32 random characters — signs the session hint cookie. Changing it
# signs everyone out.
SESSION_HINT_SECRET=

# ─── Network ──────────────────────────────────────────────────────────────────

# Only behind a reverse proxy that overwrites X-Forwarded-For (Caddy, nginx, a
# load balancer): 1 = use the client IP from it for sign-in limits. Leave
# unset when ETNA is reached directly (e.g. on a laptop) — the header could
# then be forged and limits apply per account instead.
# TRUST_PROXY=1
# Behind a Cloudflare Tunnel (cloudflared on the same machine, ETNA listening
# on 127.0.0.1 only): cloudflare = use CF-Connecting-IP, which Cloudflare sets.
# TRUST_PROXY=cloudflare

# The address people open ETNA at. Password reset and invite links made in the
# admin panel (/admin) start with it; unset = the address the admin used.
# ETNA_PUBLIC_URL=https://erp.example.com

# ─── Features ─────────────────────────────────────────────────────────────────

# Several ERPs per account, teams, sync between ERPs: on unless set to off.
# Read when the app is built: run npm run build again after changing it.
# NEXT_PUBLIC_ERP_WORKSPACES=off

# One folder for an installed server's data; the server manager sets it (with the
# other server settings) in <ETNA_DATA_ROOT>\config\etna.env, not here.
# Documents, backups and logs then default to folders in it.
# ETNA_DATA_ROOT=D:\ETNA

# Folder for uploaded documents (File → Documents). Default:
# <ETNA_DATA_ROOT>\documents, else storage/documents in the app folder.
# Back it up together with the database.
# ETNA_DOCUMENTS_DIR=

# ─── In-app backup and account administration (optional) ─────────────────────
# Written by `npm run db:backup -- setup`, which also stores the schema owner's
# password in this Windows user's PostgreSQL password file (pgpass.conf).
# Enables Settings → Backup and Settings → User accounts for the e-mails below
# (two-factor required). Leave unset on production servers: the app then never
# holds the owner password (see docs/teknis/INSTALL-SERVER.md).
# ETNA_BACKUP_DATABASE_URL=postgres://etna_owner@localhost:5432/etna
# ETNA_BACKUP_DIR=
# ETNA_ADMIN_EMAILS=admin@example.com

# ─── E-mail (optional) ────────────────────────────────────────────────────────
# Workflow approval e-mails through Resend. Both are needed to send.
# RESEND_API_KEY=
# EMAIL_FROM=ETNA <etna@example.com>

# ─── Exchange rates (optional) ────────────────────────────────────────────────
# Settings → Currencies. Frankfurter needs no key; rates are fetched on the
# server only and stored with their date and source.
# Set EXCHANGE_RATE_PROVIDER=off to allow manual rates only.
# EXCHANGE_RATE_PROVIDER=frankfurter
# FRANKFURTER_URL=https://api.frankfurter.dev/v2
# Limit to one Frankfurter source (e.g. ECB) instead of its blended rates.
# FRANKFURTER_PROVIDERS=

# ─── Command-line tools only (set in the shell, not in .env.local) ───────────
# MIGRATION_DATABASE_URL  schema owner, for npm run db:migrate and setup-local
# ADMIN_DATABASE_URL      schema owner, for scripts/admin/users.mjs
# PGPASSWORD              the owner's password for the command (not stored)
